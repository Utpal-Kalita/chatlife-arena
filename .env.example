TWITCH_USERNAME=your_bot_username
TWITCH_OAUTH=oauth:your_token_here
TWITCH_CHANNEL=your_channel
# Set to 1 to run the local fake-chat simulator without Twitch credentials.
SIMULATE_CHAT=0
# Set to 1 to read a real channel anonymously (justinfan) with no credentials; bot replies disabled.
READ_ONLY=0
PORT=3000
